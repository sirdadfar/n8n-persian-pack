# نمونهٔ متغیرهای محیطی — این فایل را به .env کپی کنید
# هیچ مقدار واقعی را داخل گیت کامیت نکنید.

# ---- فروشگاه ووکامرس ----
WOO_BASE_URL=https://shop.example.com

# ---- حسابداری ----
ACCOUNTING_API_URL=https://accounting.example.com
ACCOUNTING_API_TOKEN=change-me

# ---- پیامک (کاوه‌نگار) ----
KAVENEGAR_API_KEY=change-me
# KAVENEGAR_BASE_URL=https://api.kavenegar.com

# ---- تلگرام ----
ADMIN_TELEGRAM_CHAT_ID=
SALES_TELEGRAM_CHAT_ID=

# ---- CRM ----
CRM_API_URL=https://crm.example.com
CRM_API_TOKEN=change-me

# ---- OCR فاکتور ----
OCR_API_URL=https://api.ocr.space/parse/image
OCR_API_KEY=change-me

# ---- پایش آپتایم ----
MONITOR_URL=https://shop.example.com

# ---- اختیاری: بایگانی گزارش روزانه ----
# REPORT_WEBHOOK_URL=https://example.com/api/reports

# ---- خود n8n ----
N8N_HOST=localhost
N8N_PORT=5678
GENERIC_TIMEZONE=Asia/Tehran
TZ=Asia/Tehran
N8N_ENCRYPTION_KEY=change-me-to-a-long-random-string
N8N_BASIC_AUTH_ACTIVE=false
N8N_BASIC_AUTH_USER=
N8N_BASIC_AUTH_PASSWORD=
