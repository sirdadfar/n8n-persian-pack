      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        -320,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.billing.phone }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            },
            {
              "id": "c2",
              "leftValue": "={{ $json.meta_data.filter(m => m.key === 'reminder_sent').length }}",
              "rightValue": 1,
              "operator": {
                "type": "number",
                "operation": "smaller"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "24c7add6-1c6a-431e-89f3-8d71250f7a5e",
      "name": "قابل یادآوری است؟",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        -100,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.KAVENEGAR_BASE_URL || 'https://api.kavenegar.com' }}/v1/{{ $env.KAVENEGAR_API_KEY }}/sms/send.json",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "receptor",
              "value": "={{ $json.billing.phone }}"
            },
            {
              "name": "message",
              "value": "=سبد خرید شما آماده است 😊\n{{ ($json.line_items || []).map(i => i.name).slice(0,3).join('، ') }}\nبرای تکمیل: {{ $env.WOO_BASE_URL }}/checkout/"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "9982dfee-cbed-4db8-9c2a-e968f91f5575",
      "name": "پیامک یادآوری",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        140,
        220
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.WOO_BASE_URL }}/wp-json/wc/v3/orders/{{ $json.id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ meta_data: [ ...($json.meta_data || []).filter(m => m.key !== 'reminder_sent'), { key: 'reminder_sent', value: (($json.meta_data || []).find(m => m.key === 'reminder_sent')?.value || 0) + 1 } ] }) }}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
