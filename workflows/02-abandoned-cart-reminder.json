      "typeVersion": 3,
      "position": [
        -320,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.billing.phone }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            },
            {
              "id": "c2",
              "leftValue": "={{ $json.meta_data.filter(m => m.key === 'reminder_sent').length }}",
              "rightValue": 1,
              "operator": {
                "type": "number",
                "operation": "smaller"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "2d1946e2-8711-4785-940a-15a498bf8030",
      "name": "قابل یادآوری است؟",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        -100,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.KAVENEGAR_BASE_URL || 'https://api.kavenegar.com' }}/v1/{{ $env.KAVENEGAR_API_KEY }}/sms/send.json",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "receptor",
              "value": "={{ $json.billing.phone }}"
            },
            {
              "name": "message",
              "value": "=سبد خرید شما آماده است 😊\n{{ ($json.line_items || []).map(i => i.name).slice(0,3).join('، ') }}\nبرای تکمیل: {{ $env.WOO_BASE_URL }}/checkout/"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "84277be1-b29b-4f69-aff9-c3252be4f2c8",
      "name": "پیامک یادآوری",
