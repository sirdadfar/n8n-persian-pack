{
  "name": "۰۱ — سفارش ووکامرس → حسابداری → پیامک",
  "nodes": [
    {
      "parameters": {
        "event": "order.created",
        "options": {}
      },
      "id": "1ddf57d8-8105-4e96-9f67-42fd60993e0b",
      "name": "سفارش جدید ووکامرس",
      "type": "n8n-nodes-base.wooCommerceTrigger",
      "typeVersion": 1,
      "position": [
        -780,
        300
      ],
      "webhookId": "eaa2a063-255e-44eb-9540-8c0483c2c01d"
    },
    {
      "parameters": {
        "mode": "manual",
        "includeOtherFields": false,
        "assignments": {
          "assignments": [
            {
              "id": "1",
              "name": "order_id",
              "value": "={{ $json.id }}",
              "type": "number"
            },
            {
              "id": "2",
              "name": "customer",
              "value": "={{ $json.billing.first_name }} {{ $json.billing.last_name }}",
              "type": "string"
            },
            {
              "id": "3",
              "name": "mobile",
              "value": "={{ $json.billing.phone }}",
              "type": "string"
            },
            {
              "id": "4",
              "name": "total",
              "value": "={{ $json.total }}",
              "type": "string"
            },
            {
              "id": "5",
              "name": "items",
              "value": "={{ $json.line_items.map(i => i.name + ' x' + i.quantity).join(' | ') }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "b7679d62-1d97-4a16-b3b6-c5cf17f59a9c",
      "name": "آماده‌سازی دادهٔ سفارش",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -560,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.ACCOUNTING_API_URL }}/api/v1/invoices",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.ACCOUNTING_API_TOKEN }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ external_id: $json.order_id, customer_name: $json.customer, mobile: $json.mobile, description: $json.items, amount: Number($json.total), type: 'sale' }) }}",
        "options": {
          "response": {
            "response": {
              "neverError": true,
              "fullResponse": true
            }
          }
        }
      },
      "id": "e97680df-6f8b-45a2-87b4-05fc7e90a77f",
      "name": "ثبت فاکتور در حسابداری",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -340,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.statusCode }}",
              "rightValue": 201,
              "operator": {
                "type": "number",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "01019929-daaf-40e5-80db-8d890c36edec",
      "name": "فاکتور ثبت شد؟",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        -120,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.KAVENEGAR_BASE_URL || 'https://api.kavenegar.com' }}/v1/{{ $env.KAVENEGAR_API_KEY }}/sms/send.json",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "receptor",
              "value": "={{ $('آماده‌سازی دادهٔ سفارش').item.json.mobile }}"
            },
            {
              "name": "message",
              "value": "=سفارش {{ $('آماده‌سازی دادهٔ سفارش').item.json.order_id }} ثبت شد. مبلغ: {{ $('آماده‌سازی دادهٔ سفارش').item.json.total }} تومان"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "568adffc-d80a-46c9-9074-127b7fbdb52c",
      "name": "پیامک تأیید به مشتری",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        100,
        200
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $env.ADMIN_TELEGRAM_CHAT_ID }}",
        "text": "=⚠️ ثبت فاکتور سفارش {{ $('آماده‌سازی دادهٔ سفارش').item.json.order_id }} در حسابداری ناموفق بود.\nکد پاسخ: {{ $json.statusCode }}\nمشتری: {{ $('آماده‌سازی دادهٔ سفارش').item.json.customer }}",
        "additionalFields": {}
      },
      "id": "48f264f4-fd1f-43c3-9477-62cb335f9187",
      "name": "هشدار به مدیر در تلگرام",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        100,
        420
      ]
    },
    {
      "parameters": {},
      "id": "5e0e7724-7f9f-4533-9fb3-46e5250fefa3",
      "name": "پایان",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        320,
        300
      ]
    }
  ],
