            "amount": "={{ $json.amount }}",
            "issued_at": "={{ $json.jalali_or_gregorian_date }}",
            "needs_review": "={{ $json.needs_review }}",
            "created_at": "={{ $now.toISO() }}"
          },
          "matchingColumns": [],
          "schema": []
        },
        "options": {}
      },
