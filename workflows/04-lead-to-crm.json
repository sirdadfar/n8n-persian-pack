{
  "name": "۰۴ — لید → CRM + اعلان فوری",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "lead",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "9bfee2a0-cf3f-45fb-8600-0559e16f2e4b",
      "name": "دریافت لید",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -760,
        300
      ],
      "webhookId": "62665649-56a9-485c-b67b-754fa26b8e88"
    },
    {
      "parameters": {
        "mode": "manual",
        "includeOtherFields": false,
        "assignments": {
          "assignments": [
            {
              "id": "1",
              "name": "name",
              "value": "={{ $json.body.name || $json.body.full_name || 'بدون نام' }}",
              "type": "string"
            },
            {
              "id": "2",
              "name": "phone",
              "value": "={{ ($json.body.phone || '').replace(/[^0-9+]/g, '') }}",
              "type": "string"
            },
            {
              "id": "3",
              "name": "source",
              "value": "={{ $json.body.source || 'website' }}",
              "type": "string"
            },
            {
              "id": "4",
              "name": "message",
              "value": "={{ $json.body.message || '' }}",
              "type": "string"
            },
            {
              "id": "5",
              "name": "received_at",
              "value": "={{ $now.toISO() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "ff2ac787-aba9-498c-8ea5-3a83f7bf57e3",
      "name": "نرمال‌سازی",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -540,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.phone }}",
              "rightValue": "^09\\d{9}$",
              "operator": {
                "type": "string",
                "operation": "regex"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b3ea5220-a5ab-46f5-ad39-f5b1b3ce9ed9",
      "name": "شماره معتبر است؟",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        -320,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CRM_API_URL }}/api/leads",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.CRM_API_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "response": {
            "response": {
              "neverError": true,
              "fullResponse": true
            }
          }
        }
      },
      "id": "8799d614-3a5e-45e8-9704-9ec3d018c2f6",
      "name": "ثبت در CRM",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -100,
        220
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $env.SALES_TELEGRAM_CHAT_ID }}",
        "text": "=🔔 لید جدید از {{ $('نرمال‌سازی').item.json.source }}\nنام: {{ $('نرمال‌سازی').item.json.name }}\nموبایل: {{ $('نرمال‌سازی').item.json.phone }}\nپیام: {{ $('نرمال‌سازی').item.json.message }}",
        "additionalFields": {}
      },
      "id": "e358e293-6f16-45cc-9436-622f8222f87c",
      "name": "اعلان فوری به مدیر",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        140,
        160
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: false, error: 'invalid_phone' }) }}",
        "options": {
          "responseCode": 422
        }
      },
      "id": "64b586c7-6757-490b-a4e1-ad3533973aff",
      "name": "پاسخ: شماره نامعتبر",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        140,
        420
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true }) }}",
        "options": {}
      },
      "id": "53c577ae-5ea8-4552-89c4-79da51b456fd",
      "name": "پاسخ: ثبت شد",
      "type": "n8n-nodes-base.respondToWebhook",
