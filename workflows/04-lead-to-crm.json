{
  "name": "۰۴ — لید → CRM + اعلان فوری",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "lead",
        "authentication": "basicAuth",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "210525a0-4153-4f58-b0a9-224af27187fc",
      "name": "دریافت لید",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -760,
        300
      ],
      "webhookId": "073474e5-e739-4b6c-93d2-2e87aceadaaf",
      "credentials": {
        "httpBasicAuth": {
          "id": "persian-pack-webhook-auth",
          "name": "Webhook Basic Auth (n8n Persian Pack)"
        }
      }
    },
    {
      "parameters": {
        "mode": "manual",
        "includeOtherFields": false,
        "assignments": {
          "assignments": [
            {
              "id": "1",
              "name": "name",
              "value": "={{ $json.body.name || $json.body.full_name || 'بدون نام' }}",
              "type": "string"
            },
            {
              "id": "2",
              "name": "phone",
              "value": "={{ ($json.body.phone || '').replace(/[^0-9+]/g, '') }}",
              "type": "string"
            },
            {
              "id": "3",
              "name": "source",
              "value": "={{ $json.body.source || 'website' }}",
              "type": "string"
            },
            {
              "id": "4",
              "name": "message",
              "value": "={{ $json.body.message || '' }}",
              "type": "string"
            },
            {
              "id": "5",
              "name": "received_at",
              "value": "={{ $now.toISO() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "3de9bf69-55ab-4c21-82a4-2b57b92b7969",
      "name": "نرمال‌سازی",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -540,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.phone }}",
              "rightValue": "^09\\d{9}$",
              "operator": {
                "type": "string",
                "operation": "regex"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "5c3814cc-a085-4506-b6c6-e0086b8ee616",
      "name": "شماره معتبر است؟",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        -320,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CRM_API_URL }}/api/leads",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.CRM_API_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "response": {
            "response": {
              "neverError": true,
              "fullResponse": true
            }
          }
        }
      },
      "id": "7f7a271e-4700-44f1-9d9e-90576296cceb",
      "name": "ثبت در CRM",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -100,
        220
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $env.SALES_TELEGRAM_CHAT_ID }}",
        "text": "=🔔 لید جدید از {{ $('نرمال‌سازی').item.json.source }}\nنام: {{ $('نرمال‌سازی').item.json.name }}\nموبایل: {{ $('نرمال‌سازی').item.json.phone }}\nپیام: {{ $('نرمال‌سازی').item.json.message }}",
        "additionalFields": {}
      },
      "id": "d4108a5d-abed-453b-b576-1af1b702ae92",
      "name": "اعلان فوری به مدیر",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        140,
        160
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: false, error: 'invalid_phone' }) }}",
        "options": {
          "responseCode": 422
        }
      },
      "id": "fd8ab15c-713f-47c4-b029-6f465d1409fb",
      "name": "پاسخ: شماره نامعتبر",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        140,
        420
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true }) }}",
        "options": {}
      },
      "id": "dee043c2-97cb-42d4-8022-ed050bbe62c9",
      "name": "پاسخ: ثبت شد",
